# Valores secretos e de configuração necessários para reproduzir o projeto.
# No Node-RED, eles são definidos no início do settings.js como process.env.NOME = "valor"
# (veja node-red/README.md). Nunca publique os valores reais no repositório.

# OpenWeather
OPENWEATHER_API_KEY=sua_chave_do_openweather
OPENWEATHER_CIDADE=Sao Paulo,BR

# Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_bot
# Chat que recebe os alertas
TELEGRAM_CHAT_ID=id_do_chat_de_destino
# IDs de chat que podem consultar o bot, separados por vírgula
TELEGRAM_CHAT_IDS_AUTORIZADOS=id_1,id_2,id_3

# InfluxDB (informados no nó de configuração do Node-RED; o token fica nas credenciais e não é exportado)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=smartfarm
INFLUXDB_BUCKET=smartfarm
INFLUXDB_TOKEN=seu_token_do_influxdb

# Opcional, só para testes: sobrescreve parâmetros das regras (JSON)
# SMARTFARM_PARAMETROS={"tempoMaxIrrigacaoMin": 1, "intervaloAlertaMin": 0}
