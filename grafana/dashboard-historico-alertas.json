                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "dg564ekasyqrka"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "expr": "",
                        "format": "table",
                        "legendFormat": "__auto",
                        "range": true,
                        "rawQuery": true,
                        "rawSql": "SELECT COUNT(*) AS \"Irrigações adiadas por chuva\" FROM \"alertas\" WHERE tipo = 'chuva_prevista' AND time >= now() - INTERVAL '7 days'",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ]
                        }
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
