      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Economia de água × meta de 30% (7 dias)",
          "description": "Compara a água usada com uma rotina fixa de 60 L por dia, contando só os dias em operação. A meta do projeto é economizar pelo menos 30%: verde quando atingida, vermelho quando não.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "dg564ekasyqrka"
                      },
                      "spec": {
                        "dataset": "iox",
                        "editorMode": "code",
                        "expr": "",
                        "format": "table",
                        "legendFormat": "__auto",
                        "range": true,
                        "rawQuery": true,
                        "rawSql": "SELECT 100 * (1 - COALESCE(SUM(litros), 0) / (60.0 * (SELECT COUNT(DISTINCT date_trunc('day', time - INTERVAL '3 hours')) FROM \"telemetria\" WHERE time >= now() - INTERVAL '7 days'))) AS \"Economia\", CASE WHEN 100 * (1 - COALESCE(SUM(litros), 0) / (60.0 * (SELECT COUNT(DISTINCT date_trunc('day', time - INTERVAL '3 hours')) FROM \"telemetria\" WHERE time >= now() - INTERVAL '7 days'))) >= 30 THEN 1 ELSE 0 END AS \"Meta de 30%\", 60.0 * (SELECT COUNT(DISTINCT date_trunc('day', time - INTERVAL '3 hours')) FROM \"telemetria\" WHERE time >= now() - INTERVAL '7 days') - COALESCE(SUM(litros), 0) AS \"Economizados\", COALESCE(SUM(litros), 0) AS \"Usados\" FROM \"irrigacao\" WHERE time >= now() - INTERVAL '7 days'",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ]
                        }
                      }
